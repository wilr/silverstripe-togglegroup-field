{
    "name": "wilr/silverstripe-togglegroup-field",
    "type": "silverstripe-vendormodule",
    "description": "Toggle group form fields for the Silverstripe CMS, styled after the shadcn/ui toggle group component. Provides drop-in replacements for OptionsetField and CheckboxSetField.",
    "license": "BSD-3-Clause",
    "keywords": [
        "silverstripe",
        "cms",
        "form",
        "toggle group",
        "field"
    ],
    "authors": [
        {
            "name": "Will Rossiter",
            "email": "will.rossiter@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "silverstripe/framework": "^5"
    },
    "require-dev": {
        "dnadesign/silverstripe-elemental": "^5",
        "silverstripe/sqlite3": "^3",
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "suggest": {
        "dnadesign/silverstripe-elemental": "Allows ToggleGroupField and ToggleGroupSetField to be used inside Elemental blocks."
    },
    "autoload": {
        "psr-4": {
            "Wilr\\ToggleGroupField\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wilr\\ToggleGroupField\\Tests\\": "tests/php/"
        },
        "files": [
            "tests/php/Page.php"
        ]
    },
    "extra": {
        "expose": [
            "client"
        ],
        "screenshots": [
            "docs/en/images/toggle-group-field-page.png",
            "docs/en/images/toggle-group-field-elemental.png"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true
        }
    }
}
